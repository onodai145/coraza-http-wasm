+package wasm
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	handlerapi "github.com/http-wasm/http-wasm-host-go/api/handler"
+)
+
+// Malformed raw fragment delimiters must be rejected before the guest, while
+// percent-encoded data remains available for ordinary middleware inspection.
+func TestGuestRejectsRawFragment(t *testing.T) {
+	for _, tc := range []struct {
+		target string
+		want   int
+	}{
+		{"/#fragment", 400}, {"/test?x=#fragment", 400},
+		{"http://example.com/test#fragment", 400},
+		{"/%23fragment", 204}, {"/%2523fragment", 204},
+		{"/test?x=%23fragment", 204}, {"/test%2fpath?x=1", 204},
+	} {
+		t.Run(tc.target, func(t *testing.T) {
+			reached := false
+			g := guest{handleRequest: func(ctx context.Context) (context.Context, handlerapi.CtxNext, error) {
+				reached = true
+				requestStateFromContext(ctx).w.WriteHeader(http.StatusNoContent)
+				return ctx, 0, nil
+			}}
+			response := httptest.NewRecorder()
+			g.ServeHTTP(response, httptest.NewRequest("GET", tc.target, nil))
+			if response.Code != tc.want {
+				t.Fatalf("status=%d, want %d", response.Code, tc.want)
+			}
+			if reached != (tc.want == 204) {
+				t.Fatalf("guest reached=%v", reached)
+			}
+		})
+	}
+}
